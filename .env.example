# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values you need.
#
# Everything is optional except OPENAI_API_KEY and ANTHROPIC_API_KEY: the
# benchmark only enables the gateways whose keys are present, so you can start
# with two keys and add more later.
# ---------------------------------------------------------------------------

# Required: baseline API keys (direct providers, used as the comparison point)
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# ---------------------------------------------------------------------------
# AI Gateway API keys — set only the ones you want to benchmark
# ---------------------------------------------------------------------------
EDGEE_API_KEY=your_edgee_key
OPENROUTER_API_KEY=your_openrouter_key
ORQ_API_KEY=your_orq_key
PORTKEY_API_KEY=your_portkey_key
HELICONE_API_KEY=your_helicone_key
TRUEFOUNDRY_API_KEY=your_truefoundry_key
REQUESTY_API_KEY=your_requesty_key
VERCEL_API_KEY=your_vercel_key

# Cloudflare AI Gateway.
# ACCOUNT_ID and GATEWAY_ID address your own gateway instance — find them in the
# Cloudflare dashboard under AI > AI Gateway (the URL is
# gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>). Provider keys are
# stored on the gateway itself (BYOK).
# The Cloudflare gateway stays disabled unless both the key and the account id are set.
CLOUDFLARE_API_KEY=your_cloudflare_api_key
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_GATEWAY_ID=default

# Kong: provider keys are held by the gateway, so the URL is the enable switch
KONG_GATEWAY_URL=https://your-kong-gateway-host

# ---------------------------------------------------------------------------
# Optional: store results in BigQuery (omit entirely to just print results)
# ---------------------------------------------------------------------------
BIGQUERY_PROJECT_ID=my-project
BIGQUERY_DATASET_ID=my-dataset
BIGQUERY_TABLE_ID=results

# Google service account used for BigQuery — copy from the JSON key file
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxx@xxxx.iam.gserviceaccount.com
# Copy the entire private_key value (keep the quotes and \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Optional: tag each result with where the benchmark ran from.
# Both are plain HTTP endpoints returning JSON. Leave unset and every geo field
# is reported as "unknown" — the benchmark runs exactly the same.
#   CLIENT_GEO_URL  -> { "client": { "ip", "city", "country_code", ... } }
#   POP_REGION_URL  -> { "region": "..." }
# ---------------------------------------------------------------------------
# CLIENT_GEO_URL=https://your-geo-probe.example.com/status
# POP_REGION_URL=https://your-app.example.com/status

# Number of iterations per gateway/model (can be overridden with -i)
BENCHMARK_ITERATIONS=1
